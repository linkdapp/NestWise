# Ansible run logs — see phase-01-foundation-2node-rac-12cR2/ansible/ansible.cfg's
# log_path. Not committed: with --diff enabled, task output can include rendered
# response-file content (grid_install.rsp, db_install.rsp, dbca_gp_noncdb.rsp all
# carry SYS/SYSTEM/SYSASM passwords from group_vars/all.yml).
logs/
*.log

# Ansible retry files (retry_files_enabled = False in ansible.cfg makes these rare,
# but ignore them anyway in case that ever changes on a given run).
*.retry

# Local response-file copies some sections of installation/README.md have you edit
# in place with real passwords, outside the templated ansible/ flow.
response-files/*.rsp.local

# Real sys_password/system_password overrides — see group_vars/all.yml's comment
# and docs/known-risks.md #45. Never commit real values in group_vars/all.yml itself.
group_vars/all_local.yml
