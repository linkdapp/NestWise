127.0.0.1   localhost localhost.localdomain

# OEM Suite Server
{{ chrony_master_ip }}    {{ chrony_master_hostname }}.{{ domain }}    {{ chrony_master_hostname }}

# PRIMARY RAC DB SERVER (usatclust1) — node/VIP/SCAN entries, rendered
# UNCONDITIONALLY and EXACTLY ONCE on every host (primary and standby alike),
# using primary_nodes/primary_scan_ips/primary_scan_name — stable, deliberately
# never-redirected vars defined in group_vars/all.yml (see the comment there).
# Both clusters need to resolve each other's nodes/SCAN for Data Guard redo
# transport, RMAN, and DGMGRL. This block replaced an earlier version that used
# the group-redirected `nodes`/`scan_name`/`scan_ips` for "this cluster's own"
# entries — that meant usatclust2 twice and usatclust1 never on a standby host
# (docs/known-risks.md #86), and even after adding this Primary block back in,
# LEAVING the old redirected block in place too just produced duplicate lines on
# every host instead — James flagged that directly (#88). Removed outright:
# nothing else in this template needs the redirected `nodes`/`scan_name`/
# `scan_ips` vars — every hostname either group needs is already covered by
# this block plus the Standby block below, exactly once each.

# Primary — Public
{% for n in primary_nodes %}
{{ n.public_ip }}   {{ n.name }}.{{ domain }}     {{ n.name }}
{% endfor %}

# Primary — Private
{% for n in primary_nodes %}
{{ n.priv_ip }}     {{ n.priv_name }}.{{ domain }}   {{ n.priv_name }}
{% endfor %}

# Primary — Virtual (pre-resolve before GI install; GI manages the VIP resource after)
{% for n in primary_nodes %}
{{ n.vip_ip }}      {{ n.vip_name }}.{{ domain }}   {{ n.vip_name }}
{% endfor %}

# Primary SCAN — CHANGED 2026-08-10, per explicit instruction: back in /etc/hosts,
# but now ALL {{ primary_scan_ips | length }} IPs (was a single-IP "bootstrap
# fallback" entry, which is what caused PRVG-11368/PRVG-11826/PRVF-4664 — see
# docs/known-risks.md #28 for the full incident). Sourced from the same IPs
# dns_bind serves for usatclust1, so default /etc/nsswitch.conf order (files
# before dns) returns the full, correct IP set either way — cluvfy only checks
# IP-set count/consistency, not resolution mechanism, so this satisfies it the
# same as pure DNS would. One real, known tradeoff: unlike DNS, Linux does NOT
# round-robin multiple /etc/hosts entries for the same name by default (glibc
# returns them in file order every time) — matters less than it sounds in
# practice, since SCAN's actual client load-balancing happens at the SCAN
# listener protocol layer once a connection reaches any of the
# {{ primary_scan_ips | length }} listeners, not purely from which IP a
# client's resolver picked first.
{% for ip in primary_scan_ips %}
{{ ip }}       {{ primary_scan_name }}.{{ domain }}   {{ primary_scan_name }}
{% endfor %}

# STANDBY RAC DB SERVER (usatclust2) — node/VIP/SCAN entries, rendered
# UNCONDITIONALLY and EXACTLY ONCE on every host, same reasoning as the Primary
# block above, using standby_nodes/standby_scan_ips/standby_scan_name — also
# stable (group_vars/standby_nodes.yml never redirects these, only
# nodes/scan_name/scan_ips, which this template no longer uses at all).

# Standby — Public
{% for n in standby_nodes %}
{{ n.public_ip }}   {{ n.name }}.{{ domain }}     {{ n.name }}
{% endfor %}

# Standby — Private
{% for n in standby_nodes %}
{{ n.priv_ip }}     {{ n.priv_name }}.{{ domain }}   {{ n.priv_name }}
{% endfor %}

# Standby — Virtual
{% for n in standby_nodes %}
{{ n.vip_ip }}      {{ n.vip_name }}.{{ domain }}   {{ n.vip_name }}
{% endfor %}

# Standby SCAN
{% for ip in standby_scan_ips %}
{{ ip }}   {{ standby_scan_name }}.{{ domain }}   {{ standby_scan_name }}
{% endfor %}
