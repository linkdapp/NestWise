# Managed by Ansible — os_prep role, template grid-bash_profile.j2. Local edits will be
# overwritten on the next `ansible-playbook site.yml --tags os_prep` run; change this
# file in git, not by hand-editing /home/{{ grid_user }}/.bash_profile.

umask 022
export EDITOR=vi

export ORACLE_HOSTNAME={{ inventory_hostname }}.{{ domain }}
export ORACLE_BASE={{ grid_base }}
export GRID_HOME={{ grid_home }}
export ORACLE_HOME=$GRID_HOME
export ORACLE_SID=+ASM{{ (nodes | map(attribute='name') | list).index(inventory_hostname) + 1 }}
export ORACLE_UNQNAME=+ASM

export ORATAB=/etc/oratab
export ORACLE_TERM=xterm
export TNS_ADMIN=$GRID_HOME/network/admin

export PATH=$ORACLE_HOME/bin:$ORACLE_HOME/OPatch:/usr/bin:/usr/sbin:/bin:/sbin:/usr/bin/X11:/usr/local/bin
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:$ORACLE_HOME/oracm/lib:/lib:/usr/lib:/usr/local/lib
export CLASSPATH=$ORACLE_HOME/JRE:$ORACLE_HOME/jlib:$ORACLE_HOME/rdbms/jlib:$ORACLE_HOME/network/jlib

export TMP=/tmp
export TMPDIR=$TMP

########## End of Oracle variables ##########

# Prompt: hostname-user-ORACLE_SID, e.g. oradbserv05-grid-+ASM1$
# ${ORACLE_SID} is escaped (not $ORACLE_SID) so bash re-expands it on every prompt draw,
# not just once when this file is sourced.
export PS1="\h-\u-\${ORACLE_SID}\$ "

##### Aliases ########
alias tns='cd $GRID_HOME/network/admin'

alias stopcrs='sudo $GRID_HOME/bin/crsctl stop crs'
alias startcrs='sudo $GRID_HOME/bin/crsctl start crs'
alias checkcrs='sudo $GRID_HOME/bin/crsctl check crs'
alias stopclust='sudo $GRID_HOME/bin/crsctl stop cluster -all'
alias strtclust='sudo $GRID_HOME/bin/crsctl start cluster -all'

alias alertlog="vi $ORACLE_BASE/diag/asm/+asm/\$ORACLE_SID/trace/alert_\$ORACLE_SID.log"
alias tailalert="echo -e \"\n\nTailing $ORACLE_BASE/diag/asm/+asm/\$ORACLE_SID/trace/alert_\$ORACLE_SID.log\n\n\"; tail -f $ORACLE_BASE/diag/asm/+asm/\$ORACLE_SID/trace/alert_\$ORACLE_SID.log"

# Full OS-user switch to oracle — passwordless via /etc/sudoers.d/11-oracle-grid
# (os_prep role). Same reasoning as oracle's su2grid alias, in reverse.
alias su2oracle='sudo -iu {{ oracle_user }}'

